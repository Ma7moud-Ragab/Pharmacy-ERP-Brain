{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalCapabilities",
  "type": "object",
  "required": ["stage", "runtimeMode", "supportedReads", "supportedWrites"],
  "properties": {
    "stage": { "type": "integer", "const": 1 },
    "runtimeMode": { "type": "string", "enum": ["Cloud", "BranchLocal"] },
    "supportedReads": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supportedWrites": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}