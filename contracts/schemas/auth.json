{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Owner: erp-frontend",
  "$id": "https://example.com/contracts/schemas/auth.json",
  "title": "Pharmacy ERP — Authentication Contract (Stage 1)",
  "description": "Login / refresh / logout / me. Username uniqueness is per-organization (organization_code scopes the lookup). Refresh rotation on every use; refresh-token-family reuse detection revokes the whole family.",
  "$defs": {
    "UserRef": {
      "$ref": "identity.json#/$defs/UserDto"
    },
    "LoginRequest": {
      "type": "object",
      "required": ["organization_code", "username", "password"],
      "properties": {
        "organization_code": { "type": "string", "maxLength": 30 },
        "username": { "type": "string", "maxLength": 80 },
        "password": { "type": "string", "maxLength": 128 }
      }
    },
    "TokenPairResponse": {
      "type": "object",
      "required": [
        "access_token", "refresh_token", "expires_in", "user",
        "organization_id", "branch_scope", "branch_ids",
        "issuer", "audience", "key_id"
      ],
      "properties": {
        "access_token": { "type": "string" },
        "refresh_token": { "type": "string" },
        "expires_in": { "type": "integer", "maximum": 86400, "description": "Access-token lifetime seconds. Branch-local offline tokens capped at 24h." },
        "token_type": { "type": "string", "const": "Bearer" },
        "user": { "$ref": "identity.json#/$defs/UserDto" },
        "organization_id": { "type": "string", "format": "uuid" },
        "branch_scope": { "$ref": "common.json#/$defs/BranchScope" },
        "branch_ids": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "Explicit authorized branches; empty[] with branch_scope=ALL implies ALL organization branches."
        },
        "issuer": { "type": "string" },
        "audience": { "type": "string" },
        "key_id": { "type": "string", "description": "kid of the RS256 signing key; validate via GET /.well-known/jwks.json" }
      }
    },
    "RefreshTokenRequest": {
      "type": "object",
      "required": ["refresh_token"],
      "properties": {
        "refresh_token": { "type": "string" }
      }
    },
    "LogoutRequest": {
      "type": "object",
      "properties": {
        "refresh_token": { "type": ["string", "null"] }
      }
    },
    "CurrentUserContextDto": {
      "type": "object",
      "required": ["user", "organization_id", "branch_scope", "branch_ids", "roles", "scopes"],
      "properties": {
        "user": { "$ref": "identity.json#/$defs/UserDto" },
        "organization_id": { "type": "string", "format": "uuid" },
        "organization_code": { "type": "string" },
        "branch_scope": { "$ref": "common.json#/$defs/BranchScope" },
        "branch_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "roles": { "type": "array", "items": { "$ref": "common.json#/$defs/Role" } },
        "scopes": { "type": "array", "items": { "$ref": "common.json#/$defs/PermissionScope" } },
        "runtime": { "$ref": "common.json#/$defs/RuntimeMode" }
      }
    }
  }
}
