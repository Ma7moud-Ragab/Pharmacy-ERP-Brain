{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Owner: erp-frontend",
  "$id": "https://example.com/contracts/schemas/sales.json",
  "title": "Pharmacy ERP — Sales Contract (Stage 2, BranchLocal runtime)",
  "description": "Cashier-only POS. Counterparty rules: the FE sends product identification + quantity ONLY. The server prices lines from PRODUCT_UOM.sale_unit_price + PRODUCT.tax_rate, allocates stock FEFO, computes totals/change, and derives return batch/location. Drafts NEVER reserve stock. Full CASH payment only. Corrections are returns — never invoice edits.",
  "$defs": {
    "SalesOrderStatus": {
      "type": "string",
      "enum": ["DRAFT", "COMPLETED", "CANCELLED"]
    },
    "SalesOrderLineDto": {
      "type": "object",
      "required": ["order_line_id", "product_id", "product_uom_id", "entered_qty", "conversion_snapshot", "quantity_base", "unit_price_snapshot", "discount_amount", "tax_rate_snapshot", "tax_amount_snapshot", "line_total"],
      "properties": {
        "order_line_id": { "type": "string", "format": "uuid" },
        "product_id": { "type": "string", "format": "uuid" },
        "product_uom_id": { "type": "string", "format": "uuid" },
        "entered_qty": { "$ref": "common.json#/$defs/PositiveNumeric4" },
        "conversion_snapshot": { "$ref": "common.json#/$defs/PositiveNumeric6" },
        "quantity_base": { "$ref": "common.json#/$defs/PositiveNumeric4" },
        "unit_price_snapshot": { "$ref": "common.json#/$defs/NonNegativeNumeric4", "description": "Per entered UOM; server-copied." },
        "discount_amount": { "$ref": "common.json#/$defs/Money", "description": "Always 0 in MVP — clients cannot set discounts." },
        "tax_rate_snapshot": { "$ref": "common.json#/$defs/TaxRate", "description": "Fractional snapshot of PRODUCT.tax_rate." },
        "tax_amount_snapshot": { "$ref": "common.json#/$defs/Money" },
        "line_total": { "$ref": "common.json#/$defs/Money", "description": "= net + tax. net = round(entered_qty × unit_price_snapshot − discount_amount, 2)." }
      }
    },
    "SalesOrderDto": {
      "type": "object",
      "required": ["sales_order_id", "branch_id", "created_by_employee_id", "order_no", "channel", "order_status", "currency_code", "created_at", "lines"],
      "properties": {
        "sales_order_id": { "type": "string", "format": "uuid" },
        "branch_id": { "type": "string", "format": "uuid" },
        "created_by_employee_id": { "type": "string", "format": "uuid" },
        "order_no": { "type": "string" },
        "channel": { "type": "string", "const": "POS" },
        "order_status": { "$ref": "#/$defs/SalesOrderStatus" },
        "currency_code": { "type": "string", "description": "= Organization base_currency (EGP seeded)." },
        "estimated_subtotal": { "$ref": "common.json#/$defs/Money", "description": "Draft estimates — server-computed, informational to FE." },
        "estimated_tax_total": { "$ref": "common.json#/$defs/Money" },
        "estimated_grand_total": { "$ref": "common.json#/$defs/Money" },
        "created_at": { "$ref": "common.json#/$defs/Timestamp" },
        "completed_at": { "$ref": "common.json#/$defs/Timestamp" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/SalesOrderLineDto" } }
      }
    },
    "SalesOrderLineRequest": {
      "type": "object",
      "required": ["product_id", "product_uom_id", "entered_qty"],
      "description": "NO price, tax, discount, or total fields — those are server-authoritative.",
      "properties": {
        "product_id": { "type": "string", "format": "uuid" },
        "product_uom_id": { "type": "string", "format": "uuid" },
        "entered_qty": { "$ref": "common.json#/$defs/PositiveNumeric4" }
      }
    },
    "CreateSalesOrderRequest": {
      "type": "object",
      "required": ["branch_id", "lines"],
      "properties": {
        "branch_id": { "type": "string", "format": "uuid" },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SalesOrderLineRequest" }
        }
      }
    },
    "SalesOrderLinesRequest": {
      "type": "object",
      "required": ["lines"],
      "description": "DRAFT-only full replace of the line set (PUT /sales-orders/{id}/lines). Draft edits never touch stock.",
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SalesOrderLineRequest" }
        }
      }
    },
    "CompleteSalesOrderRequest": {
      "type": "object",
      "description": "Branch-local. Atomic server operation: invoice + cash payment + FEFO stock issue + audit + sync outbox. Rejects partial payment / unpaid credit sales.",
      "required": ["cash_tendered_amount", "method"],
      "properties": {
        "cash_tendered_amount": { "$ref": "common.json#/$defs/PositiveMoney", "description": ">0 and >= payable total; change = tendered - due must be >= 0." },
        "method": {
          "type": "string",
          "enum": ["CASH"],
          "description": "CASH only in the MVP."
        }
      }
    },
    "SalesPaymentDto": {
      "type": "object",
      "required": ["payment_id", "invoice_id", "amount_due", "cash_tendered_amount", "change_amount", "method", "received_by_employee_id", "paid_at"],
      "properties": {
        "payment_id": { "type": "string", "format": "uuid" },
        "invoice_id": { "type": "string", "format": "uuid" },
        "amount_due": { "$ref": "common.json#/$defs/Money", "description": "= exact invoice total (payment amount is not the tendered amount)." },
        "cash_tendered_amount": { "$ref": "common.json#/$defs/Money" },
        "change_amount": { "$ref": "common.json#/$defs/Money", "description": "= tendered - due; >= 0." },
        "method": { "type": "string", "const": "CASH" },
        "received_by_employee_id": { "type": "string", "format": "uuid" },
        "paid_at": { "$ref": "common.json#/$defs/Timestamp" }
      }
    },
    "SalesInvoiceStatus": { "type": "string", "enum": ["ISSUED"], "description": "Only value: invoices exist only on completed sale; immutable identity + snapshots." },
    "SalesInvoicePaymentStatus": {
      "type": "string",
      "enum": ["PAID", "PARTIALLY_REFUNDED", "REFUNDED"],
      "description": "Settlement projection; only paid_amount/refunded_amount/payment_status may move after issue."
    },
    "SalesInvoiceLineDto": {
      "type": "object",
      "description": "POSTED: all snapshots immutable. unit_cost_snapshot is the weighted summary of actual batch allocations.",
      "required": ["invoice_line_id", "source_order_line_id", "product_id", "product_uom_id", "entered_qty", "conversion_snapshot", "quantity_base", "unit_price_snapshot", "discount_amount", "tax_rate_snapshot", "tax_amount_snapshot", "net_amount", "line_total", "unit_cost_snapshot"],
      "properties": {
        "invoice_line_id": { "type": "string", "format": "uuid" },
        "source_order_line_id": { "type": "string", "format": "uuid" },
        "product_id": { "type": "string", "format": "uuid" },
        "product_uom_id": { "type": "string", "format": "uuid" },
        "entered_qty": { "$ref": "common.json#/$defs/PositiveNumeric4" },
        "conversion_snapshot": { "$ref": "common.json#/$defs/PositiveNumeric6" },
        "quantity_base": { "$ref": "common.json#/$defs/PositiveNumeric4" },
        "unit_price_snapshot": { "$ref": "common.json#/$defs/NonNegativeNumeric4" },
        "discount_amount": { "$ref": "common.json#/$defs/Money" },
        "tax_rate_snapshot": { "$ref": "common.json#/$defs/TaxRate" },
        "tax_amount_snapshot": { "$ref": "common.json#/$defs/Money" },
        "net_amount": { "$ref": "common.json#/$defs/Money", "description": "tax-exclusive." },
        "line_total": { "$ref": "common.json#/$defs/Money", "description": "tax-inclusive; the refundable base." },
        "unit_cost_snapshot": { "$ref": "common.json#/$defs/NonNegativeNumeric4" }
      }
    },
    "SalesInvoiceDto": {
      "type": "object",
      "required": ["invoice_id", "sales_order_id", "branch_id", "invoice_no", "status", "currency_code", "subtotal", "discount_total", "tax_total", "grand_total", "paid_amount", "refunded_amount", "payment_status", "issued_at", "lines"],
      "properties": {
        "invoice_id": { "type": "string", "format": "uuid" },
        "sales_order_id": { "type": "string", "format": "uuid" },
        "branch_id": { "type": "string", "format": "uuid" },
        "invoice_no": { "type": "string", "maxLength": 40 },
        "status": { "$ref": "#/$defs/SalesInvoiceStatus" },
        "currency_code": { "type": "string" },
        "subtotal": { "$ref": "common.json#/$defs/Money" },
        "discount_total": { "$ref": "common.json#/$defs/Money" },
        "tax_total": { "$ref": "common.json#/$defs/Money" },
        "grand_total": { "$ref": "common.json#/$defs/Money" },
        "paid_amount": { "$ref": "common.json#/$defs/Money" },
        "refunded_amount": { "$ref": "common.json#/$defs/Money" },
        "payment_status": { "$ref": "#/$defs/SalesInvoicePaymentStatus" },
        "issued_at": { "$ref": "common.json#/$defs/Timestamp" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/SalesInvoiceLineDto" } },
        "payments": { "type": "array", "items": { "$ref": "#/$defs/SalesPaymentDto" } },
        "returns_summary": { "type": "array", "items": { "$ref": "#/$defs/SalesReturnDto" } }
      }
    },
    "CompleteSalesOrderResultDto": {
      "type": "object",
      "description": "Everything created by the checkout in one response.",
      "required": ["sales_order", "invoice", "payment", "inventory_txn"],
      "properties": {
        "sales_order": { "$ref": "#/$defs/SalesOrderDto" },
        "invoice": { "$ref": "#/$defs/SalesInvoiceDto" },
        "payment": { "$ref": "#/$defs/SalesPaymentDto" },
        "inventory_txn": { "$ref": "inventory.json#/$defs/InventoryTxnDto" }
      }
    },
    "ReturnDisposition": {
      "type": "string",
      "enum": ["RESTOCK", "QUARANTINE", "SCRAP"],
      "description": "RESTOCK-> sellable location; QUARANTINE-> quarantine location; SCRAP-> positive receipt into SCRAP + equal linked scrap issue (net on-hand 0). Destination is ALWAYS server-selected."
    },
    "SalesReturnStatus": { "type": "string", "enum": ["DRAFT", "POSTED", "CANCELLED"] },
    "SalesRefundStatus": { "type": "string", "enum": ["NOT_REFUNDED", "PARTIALLY_REFUNDED", "REFUNDED"] },
    "SalesReturnLineRequest": {
      "type": "object",
      "required": ["invoice_line_id", "quantity_base", "disposition"],
      "description": "FE does NOT choose batch_id or destination_location_id — the server derives them from the original SALE_ISSUE allocation and rejects over-returns.",
      "properties": {
        "invoice_line_id": { "type": "string", "format": "uuid" },
        "quantity_base": { "$ref": "common.json#/$defs/PositiveNumeric4", "description": "<= remaining sold quantity for that invoice line." },
        "disposition": { "$ref": "#/$defs/ReturnDisposition" }
      }
    },
    "SalesReturnRequest": {
      "type": "object",
      "description": "Must be processed AT the invoice branch; within 14 calendar days of issue measured in the Organization time zone.",
      "required": ["invoice_id", "reason_code", "lines"],
      "properties": {
        "invoice_id": { "type": "string", "format": "uuid" },
        "reason_code": { "type": "string", "maxLength": 40 },
        "approved_by_employee_id": {
          "type": ["string", "null"],
          "format": "uuid",
          "description": "Optional; must differ from the receiving cashier and be an active Admin/Pharmacist authorized at the invoice branch."
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SalesReturnLineRequest" }
        },
        "refund_requested": { "type": "boolean", "default": true, "description": "Cash refund posted atomically with the return; amounts are server-computed from invoice line totals (capped by remaining paid/refundable amounts)." }
      }
    },
    "SalesReturnLineDto": {
      "type": "object",
      "required": ["return_line_id", "invoice_line_id", "product_id", "batch_id", "destination_location_id", "quantity_base", "refund_amount", "disposition"],
      "properties": {
        "return_line_id": { "type": "string", "format": "uuid" },
        "invoice_line_id": { "type": "string", "format": "uuid" },
        "product_id": { "type": "string", "format": "uuid" },
        "batch_id": { "type": "string", "format": "uuid", "description": "Server-derived from the original posted sale allocation." },
        "destination_location_id": { "type": "string", "format": "uuid", "description": "Server-selected (source sale location if SELLABLE, else branch default of the disposition type)." },
        "quantity_base": { "$ref": "common.json#/$defs/PositiveNumeric4" },
        "refund_amount": { "$ref": "common.json#/$defs/Money", "description": "Proportional share of the original tax-inclusive line_total; residual-cent rules apply." },
        "disposition": { "$ref": "#/$defs/ReturnDisposition" }
      }
    },
    "SalesRefundDto": {
      "type": "object",
      "required": ["refund_id", "sales_return_id", "invoice_id", "amount", "method", "processed_by_employee_id", "refunded_at"],
      "properties": {
        "refund_id": { "type": "string", "format": "uuid" },
        "sales_return_id": { "type": "string", "format": "uuid" },
        "invoice_id": { "type": "string", "format": "uuid" },
        "amount": { "$ref": "common.json#/$defs/Money", "description": "Capped by paid_amount minus prior refunds and by returned line refundable value." },
        "method": { "type": "string", "const": "CASH" },
        "processed_by_employee_id": { "type": "string", "format": "uuid" },
        "refunded_at": { "$ref": "common.json#/$defs/Timestamp" }
      }
    },
    "SalesReturnDto": {
      "type": "object",
      "required": ["return_id", "invoice_id", "branch_id", "return_no", "status", "reason_code", "refund_amount", "refund_status", "received_by_employee_id", "received_at", "lines"],
      "properties": {
        "return_id": { "type": "string", "format": "uuid" },
        "invoice_id": { "type": "string", "format": "uuid" },
        "branch_id": { "type": "string", "format": "uuid" },
        "return_no": { "type": "string", "maxLength": 40 },
        "status": { "$ref": "#/$defs/SalesReturnStatus" },
        "reason_code": { "type": "string", "maxLength": 40 },
        "refund_amount": { "$ref": "common.json#/$defs/Money" },
        "refund_status": { "$ref": "#/$defs/SalesRefundStatus" },
        "received_by_employee_id": { "type": "string", "format": "uuid" },
        "approved_by_employee_id": { "type": ["string", "null"], "format": "uuid" },
        "received_at": { "$ref": "common.json#/$defs/Timestamp" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/SalesReturnLineDto" } },
        "inventory_txns": {
          "type": "array",
          "maxItems": 2,
          "description": "Zero transactions for a non-restocking return, one SALES_RETURN_IN when stock is restocked/quarantined, and up to two when RESTOCK plus an additional SCRAP_OUT is required. Server-created only.",
          "items": { "$ref": "inventory.json#/$defs/InventoryTxnDto" }
        },
        "refund": { "$ref": "#/$defs/SalesRefundDto" }
      }
    }
  }
}
